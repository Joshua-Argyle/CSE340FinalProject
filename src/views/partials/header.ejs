<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/main.css">
    <%- renderStyles() %>
    <%- renderScripts() %> 
    <% if (NODE_ENV.includes('dev')) { %>
    <script>
        // Get the current hostname and port from the browser
        const host = window.location.hostname;
        const currentPort = window.location.port;
        // Calculate WebSocket port (current port + 1)
        const wsPort = currentPort ? (parseInt(currentPort) + 1) : 3001;
        // Create WebSocket connection using dynamic hostname and port
        const ws = new WebSocket(`ws://${host}:${wsPort}`);
        ws.onclose = () => {
            setTimeout(() => location.reload(), 2000);
        };
    </script>
<% } %>
</head>
<body class="<%= bodyClass %>">
    <header>
    <nav>
        <ul>
            <li class="site-brand-item"><a class="site-brand" href="/">Rico's Risk Free Cars</a></li>
            <!-- Always visible links -->
            <li><a href="/">Home</a></li>

            <!-- Only visible when logged in -->
            <% if (isLoggedIn) { %>
                <li><a href="/dashboard">Dashboard</a></li>
                <% if (user && (user.roleName === 'admin' || user.roleName === 'employee')) { %>
                    <li><a href="/inventory">Inventory Management</a></li>
                    <li><a href="/service-request/responses">Manage Service Requests</a></li>
                    <li><a href="/contact">Manage Messages</a></li>
                <% } else if (user && user.roleName === 'user') { %>
                    <li><a href="/catalog">Vehicle Catalog</a></li>
                    <li><a href="/service-request/responses">My Service Requests</a></li>
                    <li><a href="/contact">Contact</a></li>
                <% } %>
                <li><a href="/service-request">Submit Service Request</a></li>
                <li><a href="/logout">Logout</a></li>

            <% } %>

            <!-- Only visible when NOT logged in -->
            <% if (!isLoggedIn) { %>
                <li><a href="/login">Login</a></li>
                <li><a href="/register">Register</a></li>
                <li><a href="/contact">Contact</a></li>
                <li><a href="/catalog">Vehicle Catalog</a></li>
            <% } %>
        </ul>
    </nav>
    </header>

<% 
    const messages = flash();
    const hasMessages = Object.values(messages).some(arr => arr.length > 0);
%>

<% if (hasMessages) { %>
    <div class="flash-messages">
        <% Object.keys(messages).forEach(type => { %>
            <% messages[type].forEach(message => { %>
                <div class="flash <%= type %>">
                    <%= message %>
                </div>
            <% }); %>
        <% }); %>
    </div>
<% } %>