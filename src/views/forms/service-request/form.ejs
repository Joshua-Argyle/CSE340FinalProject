<%- include('../../partials/header') %>
<main>
    <h1><%= title %></h1>
    <p>
        Submit a service request for your vehicle. Please provide the vehicle details and a brief description of the issue or service needed.
    </p>

    <form method="POST" action="/service-request" class="service-request-form" novalidate>
        <div class="form-group">
            <label for="vin">Vehicle VIN</label>
            <input type="text" id="vin" name="vin" placeholder="Enter 17-character vehicle VIN" minlength="17" maxlength="17" required>
        </div>

        <div class="form-group">
            <label for="make">Make</label>
            <input type="text" id="make" name="make" placeholder="Enter vehicle make" required>
        </div>

        <div class="form-group">
            <label for="model">Model</label>
            <input type="text" id="model" name="model" placeholder="Enter vehicle model" required>
        </div>

        <div class="form-group">
            <label for="year">Year</label>
            <input type="number" id="year" name="year" placeholder="Enter vehicle year" min="1900" max="2099" required>
        </div>

        <div class="form-group">
            <label for="serviceType">Service Type</label>
            <select id="serviceType" name="serviceType" required>
                <option value="">Select a service type</option>
                <option value="Maintenance">Maintenance</option>
                <option value="Repair">Repair</option>
                <option value="Inspection">Inspection</option>
                <option value="Other">Other</option>
            </select>
        </div>

        <div class="form-group">
            <label for="description">Service Description</label>
            <textarea id="description" name="description" rows="6" placeholder="Describe the services requested or any problems you are experiencing" minlength="10" required></textarea>
        </div>

        <button type="submit">Submit Service Request</button>
    </form>
</main>
<%- include('../../partials/footer') %>