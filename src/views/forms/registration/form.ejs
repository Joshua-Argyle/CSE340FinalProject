<%- include('../../partials/header') %>
<main>
    <h1><%= title %></h1>
    <p>
        Register for a new account by providing your information below. All fields are required and passwords must meet security requirements.
    </p>

    <form method="POST" action="/register" class="registration-form" novalidate>
        <!-- Name field -->
        <div class="form-group">
            <!-- Add label for="name" -->
            <label for="name">Name</label>
            <!-- Add input type="text" id="name" name="name" -->
             <input type = text id="name" name="name" minlength="2" required placeholder="Enter your name" required>
            <!-- Added minlength="2" and required attributes -->
            <!-- Added appropriate placeholder text -->
        </div>  

        <!-- Email field -->
        <!-- TODO: Create form-group div -->
        <div class="form-group">
            <!-- Add label for email -->  
             <label for="email">Email</label>
            <!-- Add input type="email" with id, name, and required -->
             <input type="email" id="email" name="email" required>
        </div>
        
        <!-- Email confirmation field -->
            <!-- Create form-group div for emailConfirm -->
            <!-- Should match email field structure -->
            <!-- Use name="emailConfirm" --> 

        <div class="form-group">

             <label for="emailConfirm">Confirm Email</label>
            
             <input type="email" id="emailConfirm" name="emailConfirm" required>
        </div>

        <!-- Password field -->
         <div class="form-group">
             <label for="password">Password</label>
             <input type="password" id="password" name="password" minlength="8" required pattern="(?=.*[0-9])(?=.*[!@#$%^&*]).*">
             <div class="help-text">Must be at least 8 characters with a number and special character</div>
         </div>

        <!-- Password confirmation field -->
        <div class="form-group">
            <label for="passwordConfirm">Confirm Password</label>
            <input type="password" id="passwordConfirm" name="passwordConfirm" minlength="8" required pattern="(?=.*[0-9])(?=.*[!@#$%^&*]).*">
        </div>

        <!-- Submit button -->
        <!-- TODO: Add button type="submit" with text like "Create Account" -->
         <button type="submit">Create Account</button>
    </form>
</main>
<%- include('../../partials/footer') %>