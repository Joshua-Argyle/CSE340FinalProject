<%- include('../partials/header') %>
<main>
    <section class="inventory-header">
        <h1>Create Vehicle</h1>
        <p>Use this form to add a complete vehicle listing, including its image.</p>
        <p><a href="/inventory">Back to Inventory Management</a></p>
    </section>

    <section>
        <form action="/inventory/vehicles/new" method="post">
            <label for="category_id">Category</label>
            <select id="category_id" name="category_id" required>
                <% categories.forEach(category => { %>
                    <option value="<%= category.categoryId %>"><%= category.name %></option>
                <% }); %>
            </select>

            <label for="make">Make</label>
            <input id="make" type="text" name="make" required>

            <label for="model">Model</label>
            <input id="model" type="text" name="model" required>

            <label for="year">Year</label>
            <input id="year" type="number" name="year" min="1885" required>

            <label for="mileage">Mileage</label>
            <input id="mileage" type="number" name="mileage" min="0" required>

            <label for="color">Color</label>
            <input id="color" type="text" name="color" required>

            <label for="transmission">Transmission</label>
            <input id="transmission" type="text" name="transmission" required>

            <label for="fuel_type">Fuel Type</label>
            <input id="fuel_type" type="text" name="fuel_type" required>

            <label for="drivetrain">Drivetrain</label>
            <input id="drivetrain" type="text" name="drivetrain" required>

            <label for="vin">VIN</label>
            <input id="vin" type="text" name="vin" minlength="17" maxlength="17" required>

            <label for="price">Price</label>
            <input id="price" type="number" name="price" step="0.01" min="0" required>

            <label for="description">Description</label>
            <textarea id="description" name="description" rows="4" required></textarea>

            <label for="image_url">Image URL</label>
            <input id="image_url" type="text" name="image_url" placeholder="/images/vehicles/example.jpg" required>

            <label for="image_description">Image Description</label>
            <textarea id="image_description" name="image_description" rows="3" required></textarea>

            <label for="status">Status</label>
            <select id="status" name="status" required>
                <option value="available">available</option>
                <option value="pending">pending</option>
                <option value="sold">sold</option>
            </select>

            <button type="submit">Create Vehicle</button>
        </form>
    </section>
</main>
<%- include('../partials/footer') %>
