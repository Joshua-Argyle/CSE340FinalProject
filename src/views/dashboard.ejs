<%- include('partials/header') %>
<main>
    <h1>Dashboard</h1>
    <p><%= greeting %></p>

    <% if (isAdmin) { %>
        <section>
            <h2>All Users</h2>

            <% if (users && users.length > 0) { %>
                <table>
                    <thead>
                        <tr>
                            <th>User ID</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Created</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% users.forEach(currentUser => { %>
                            <tr>
                                <td><%= currentUser.user_id %></td>
                                <td><%= currentUser.name %></td>
                                <td><%= currentUser.email %></td>
                                <td><%= currentUser.roleName || 'user' %></td>
                                <td><%= new Date(currentUser.created_at).toLocaleDateString() %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            <% } else { %>
                <p>No users found.</p>
            <% } %>
        </section>
    <% } %>
</main>
<%- include('partials/footer') %>
